    def "Materials"
    {
        def Material "TilePanel"
        {
            token outputs:surface.connect = </FloorTile/Materials/TilePanel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.19)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }

        def Material "Grille"
        {
            token outputs:surface.connect = </FloorTile/Materials/Grille/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }
}

