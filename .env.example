# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Google AI Configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project"}
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Vertex Search Configuration
VERTEX_DATA_STORE_ID=your-datastore-id

# Supabase Service Keys (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co

# Edge Function browser origins (exact, comma-separated HTTPS origins)
CORS_ALLOWED_ORIGINS=https://auradc.m2mtechconnect.com,https://aura.m2mtechconnect.com,https://m2mdc.lovable.app

# Strict AURA white-label managed connector policy (server-side)
AURA_STRICT_WHITE_LABEL=true
AURA_MANAGED_CONNECTOR_GATEWAY_URL=https://gateway.auradc.m2mtechconnect.com
AURA_MANAGED_GATEWAY_TOKEN=replace-with-server-only-ingress-token

# AURA Integration Gateway service configuration (server-side gateway only)
AURA_GATEWAY_PUBLIC_ORIGIN=https://gateway.auradc.m2mtechconnect.com
AURA_GATEWAY_INGRESS_TOKEN=replace-with-server-only-ingress-token
AURA_CONNECTOR_UPSTREAM_URL=https://connector-upstream.example.com
AURA_CONNECTOR_UPSTREAM_TOKEN=replace-with-server-only-upstream-token

# AURA demo-only integration presentation. Keep false outside approved demo builds.
VITE_AURA_DEMO_INTEGRATIONS=false
VITE_AURA_DEMO_MANAGED_OAUTH=false

# Demo-only Managed User OAuth server gate. This MUST remain false outside an
# explicitly isolated demo environment. The browser flag above cannot enable it.
AURA_RELEASE_ENVIRONMENT=production
AURA_DEMO_MANAGED_OAUTH=false
GOOGLE_DRIVE_APP_USER_CONNECTOR_CLIENT_API_KEY=replace-with-demo-only-server-secret

# Legacy managed connector credential. Production strict-white-label flows do
# not consume this directly. Phase D5 may use it only when BOTH
# AURA_RELEASE_ENVIRONMENT=demo and AURA_DEMO_MANAGED_OAUTH=true.
LOVABLE_API_KEY=auto-generated-by-lovable

# Zapier Configuration (Optional / legacy)
ZAPIER_CLIENT_ID=your-zapier-client-id
ZAPIER_CLIENT_SECRET=your-zapier-client-secret
ZAPIER_REDIRECT_URL=https://your-app.com/zapier/callback

# MCP Test Server (for testing only)
MCP_TEST_SERVER_1_URL=http://localhost:8080
MCP_TEST_SERVER_1_TOKEN=test-token-123

# AOC Mock Data (Development only)
VITE_USE_MOCK_AOC=false

# SEO Build Gate
# Production base URL used to validate <link rel="canonical"> and og:url
# at build time. Staging/dev builds must point canonical at this origin
# or the build gate fails. Defaults to https://auradc.m2mtechconnect.com.
PROD_BASE_URL=https://auradc.m2mtechconnect.com
