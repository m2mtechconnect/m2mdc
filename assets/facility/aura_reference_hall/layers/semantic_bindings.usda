{
    def Xform "SemanticBindings"
    {
        custom string aura:bindingContract = "assets/facility/aura_reference_hall/semantic_bindings.json"
        custom string aura:dsxAlignment = "Aligned with the NVIDIA Omniverse DSX Blueprint (Flex, Boost, Exchange)."
    }
}

