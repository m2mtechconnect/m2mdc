#usda 1.0
(
    defaultPrim = "Luminaire"
    doc = "AURA-authored generic 1500 mm suspended linear data-hall luminaire. This asset carries VISIBLE FIXTURE GEOMETRY ONLY. Illumination in the browser runtime is produced by native scene lights, not by this geometry."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Luminaire" (
    kind = "component"
)
{
    custom string aura:assetId = "aura.lighting.linear_luminaire_1500"
    custom string aura:author = "M2M AURA (AURA-authored generic asset)"
    custom bool aura:emitsLight = 0
    custom string aura:equipmentClass = "luminaire"
    custom string aura:evidenceMode = "SIMULATED"
    custom string aura:licence = "AURA-authored, internal use by M2M Technology Connect. Generic geometry, not vendor-certified, not SimReady."
    custom string aura:lightingNote = "Fixture geometry only. Runtime illumination is computed by browser-native lights."
    custom string aura:semanticRole = "luminaire"
    custom bool aura:simReady = 0
    custom string aura:telemetryBindingId = ""
    custom bool aura:vendorCertified = 0

    def "Materials"
    {
        def Material "Housing"
        {
            token outputs:surface.connect = </Luminaire/Materials/Housing/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.83, 0.85)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Diffuser"
        {
            token outputs:surface.connect = </Luminaire/Materials/Diffuser/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.96, 1)
                color3f inputs:emissiveColor = (0.85, 0.88, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def "Geometry"
    {
        def Mesh "Housing" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.75, -0.07, -0.06), (0.75, 0, 0.06)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            rel material:binding = </Luminaire/Materials/Housing>
            point3f[] points = [(-0.75, -0.07, -0.06), (0.75, -0.07, -0.06), (0.75, 0, -0.06), (-0.75, 0, -0.06), (-0.75, -0.07, 0.06), (0.75, -0.07, 0.06), (0.75, 0, 0.06), (-0.75, 0, 0.06)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Diffuser" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.72, -0.081, -0.05), (0.72, -0.069, 0.05)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            rel material:binding = </Luminaire/Materials/Diffuser>
            point3f[] points = [(-0.72, -0.081, -0.05), (0.72, -0.081, -0.05), (0.72, -0.069, -0.05), (-0.72, -0.069, -0.05), (-0.72, -0.081, 0.05), (0.72, -0.081, 0.05), (0.72, -0.069, 0.05), (-0.72, -0.069, 0.05)]
            uniform token subdivisionScheme = "none"
        }

        def "Suspension"
        {
            def Mesh "Rod_n" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-0.556, 0, -0.006), (-0.544, 0.3, 0.006)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </Luminaire/Materials/Housing>
                point3f[] points = [(-0.556, 0, -0.006), (-0.544, 0, -0.006), (-0.544, 0.3, -0.006), (-0.556, 0.3, -0.006), (-0.556, 0, 0.006), (-0.544, 0, 0.006), (-0.544, 0.3, 0.006), (-0.556, 0.3, 0.006)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Rod_p" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(0.544, 0, -0.006), (0.556, 0.3, 0.006)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </Luminaire/Materials/Housing>
                point3f[] points = [(0.544, 0, -0.006), (0.556, 0, -0.006), (0.556, 0.3, -0.006), (0.544, 0.3, -0.006), (0.544, 0, 0.006), (0.556, 0, 0.006), (0.556, 0.3, 0.006), (0.544, 0.3, 0.006)]
                uniform token subdivisionScheme = "none"
            }
        }
    }
}

