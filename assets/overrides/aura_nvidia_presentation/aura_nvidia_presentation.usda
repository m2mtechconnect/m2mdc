#usda 1.0
(
    """AURA-authored material and presentation override layer.

       Provenance: NVIDIA OpenUSD-derived geometry with AURA-authored material,
       lighting and visualization enhancements.

       This layer is NON-DESTRUCTIVE. It references the unchanged NVIDIA source
       stages and authors only material class assignments and presentation
       metadata as `over` prims. No geometry, prim path, dimension, transform or
       vendor identity is modified. Not NVIDIA-authored. Not SimReady-certified.
       Not Omniverse-rendered. Not RTX-rendered.
    """
    defaultPrim = "AURA_Presentation"
    metersPerUnit = 1
    upAxis = "Y"
)

