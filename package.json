{
  "name": "aura-dc-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:a11y": "playwright test --config=playwright.truth.config.ts axe-a11y.spec.ts",
    "test:truth": "playwright test --config=playwright.truth.config.ts",
    "test:route-stress": "playwright test --config=playwright.route-stress.config.ts",
    "verify:dsx-phase7": "node scripts/dsx-phase7-verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit src",
    "test:unit:coverage": "vitest run tests/unit src --coverage",
    "test:int": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:record": "playwright test --update-snapshots",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "db:seed:studio": "tsx scripts/seed.ts",
    "guard:test-env": "node scripts/aura-test-env-guard.mjs",
    "db:migrate:test": "node scripts/aura-test-env-guard.mjs && supabase db push --project-ref $SUPABASE_PROJECT_ID",
    "db:reset:test": "node scripts/aura-test-env-guard.mjs && supabase db reset --linked",
    "lint:dsx": "eslint src/dsx src/components/dsx",
    "test:dsx": "vitest run src/dsx",
    "test:twin-canvas": "playwright test --config=playwright.gpu.config.ts",
    "test:twin-canvas:software": "AURA_GPU_LANE=software playwright test --config=playwright.gpu.config.ts",
    "test:twin-canvas:gpu": "AURA_GPU_LANE=gpu AURA_GPU_REQUIRED=1 playwright test --config=playwright.gpu.config.ts",
    "report:gpu-matrix": "node scripts/report-gpu-matrix.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^10.1.0",
    "@hookform/resolvers": "^3.10.0",
