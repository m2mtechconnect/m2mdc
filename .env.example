# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Google AI Configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project"}
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Vertex Search Configuration
VERTEX_DATA_STORE_ID=your-datastore-id

# Supabase Service Keys (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co

# Lovable AI
LOVABLE_API_KEY=auto-generated-by-lovable

# Zapier Configuration (Optional)
ZAPIER_CLIENT_ID=your-zapier-client-id
ZAPIER_CLIENT_SECRET=your-zapier-client-secret
ZAPIER_REDIRECT_URL=https://your-app.com/zapier/callback

# MCP Test Server (for testing)
MCP_TEST_SERVER_1_URL=http://localhost:8080
MCP_TEST_SERVER_1_TOKEN=test-token-123

# AOC Mock Data (Development only)
VITE_USE_MOCK_AOC=false

# SEO Build Gate
# Production base URL used to validate <link rel="canonical"> and og:url
# at build time. Staging/dev builds must point canonical at this origin
# or the build gate fails. Defaults to https://auradc.m2mtechconnect.com.
PROD_BASE_URL=https://auradc.m2mtechconnect.com
