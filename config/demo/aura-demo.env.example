# AURA demo build profile — safe placeholders only.
# Never put production credentials or service-role secrets in this file.

VITE_AURA_DEMO_INTEGRATIONS=true
VITE_AURA_DEMO_MANAGED_OAUTH=true
AURA_RELEASE_ENVIRONMENT=demo
AURA_BUILD_ID=aura-demo-local

# Demo builds intentionally canonicalize to the primary AURA origin unless a
# separately approved demo-domain SEO policy is introduced.
PROD_BASE_URL=https://auradc.m2mtechconnect.com

# Public client placeholders used only to prove the static demo artifact builds.
# A live demo environment must receive its approved non-production values from
# environment/secret management, not from Git.
VITE_SUPABASE_URL=https://demo-placeholder.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=demo-public-placeholder

# Interactive sign-in is a two-sided gate. The VITE flag only renders the demo
# controls. Server-side authorization additionally requires:
#   AURA_RELEASE_ENVIRONMENT=demo
#   AURA_DEMO_MANAGED_OAUTH=true
#   GOOGLE_DRIVE_APP_USER_CONNECTOR_CLIENT_API_KEY=<server secret>
#   LOVABLE_API_KEY=<server secret used only by the demo authorization transport>
# None of those server secrets belong in a VITE_ variable or in Git.
