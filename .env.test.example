# Test environment TEMPLATE. Copy to .env.test locally (git-ignored) or
# supply the values from CI-managed secrets. Names and placeholders only:
# never commit a real value to this file.

# Backend (local Supabase stack or a disposable test project)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=__SET_IN_CI__
VITE_SUPABASE_PROJECT_ID=__SET_IN_CI__

# Mock configuration
USE_MOCK_LLM=true
USE_REAL_ZAPIER=false

# Test credentials - provisioned per-run by CI, never hardcoded
TEST_USER_EMAIL=__SET_IN_CI__
TEST_USER_PASSWORD=__SET_IN_CI__

# Feature flags for testing
ENABLE_VISUAL_REGRESSION=true
ENABLE_PERFORMANCE_TESTS=true
ENABLE_A11Y_TESTS=true

# CI configuration
CI=false
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false
